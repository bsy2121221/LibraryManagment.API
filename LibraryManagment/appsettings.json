{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "LibraryManagement.API",
    "Audience": "LibraryManagement.Web",
    "SecretKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "AdminSeed": {
    "FullName": "Administrator",
    "Mobile": "",
    "Password": ""
  },

  "Payment": {
    "Provider": "Mock",
    "Currency": "INR",
    "Razorpay": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    }
  },

  "Notifications": {
    "Sms": {
      "Provider": "Mock",
      "Msg91": { "AuthKey": "", "SenderId": "", "DltTemplateId": "" }
    },
    "WhatsApp": {
      "Provider": "Mock",
      "Meta": { "AccessToken": "", "PhoneNumberId": "" }
    },
    "Email": {
      "Provider": "Mock",
      "Smtp": { "Host": "smtp.gmail.com", "Port": 587, "Username": "", "Password": "", "FromName": "My Library" }
    },
    "Voice": {
      "Provider": "Mock",
      "Twilio": { "AccountSid": "", "AuthToken": "", "FromNumber": "" }
    }
  },

  "Storage": {
    "Provider": "Local",
    "Local": { "RootPath": "wwwroot/uploads" },
    "AzureBlob": { "ConnectionString": "", "Container": "media" }
  }
}
