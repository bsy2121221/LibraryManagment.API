{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LibraryManagement.API",
    "Audience": "LibraryManagement.Web",
    "SecretKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AdminSeed": {
    "FullName": "Administrator",
    "Mobile": "",
    "Password": ""
  },
  "Payment": {
    "Provider": "Mock",
    "Currency": "INR",
    "Razorpay": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    }
  },
  "Notifications": {
    "DispatchIntervalSeconds": 60,
    "BatchSize": 50,
    "DefaultCountryCode": "91",
    "Sms": {
      "Provider": "Mock",
      "Msg91": {
        "AuthKey": "",
        "SenderId": "",
        "DltTemplateId": "",
        "FlowTemplateId": ""
      }
    },
    "WhatsApp": {
      "Provider": "Mock",
      "Meta": {
        "AccessToken": "",
        "PhoneNumberId": "",
        "ApiVersion": "v21.0"
      }
    },
    "Email": {
      "Provider": "Mock",
      "Smtp": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "Username": "",
        "Password": "",
        "FromName": "My Library",
        "FromEmail": "",
        "EnableSsl": true
      }
    },
    "Voice": {
      "Provider": "Mock",
      "Twilio": {
        "AccountSid": "",
        "AuthToken": "",
        "FromNumber": "",
        "Language": "en-IN"
      }
    }
  },
  "Storage": {
    "Provider": "Local",
    "MaxUploadMb": 5,
    "Local": {
      "RootPath": "wwwroot/uploads",
      "RequestPath": "/uploads"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "Container": "media"
    }
  }
}
